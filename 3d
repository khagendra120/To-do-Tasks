      state.dialColor = btn.dataset.dial;
      mat.dial.map = createDialTexture(state.dialColor);
      mat.dial.needsUpdate = true;
      document.getElementById('dial-label').textContent = dialLabels[state.dialColor];
    });
  });

  // Strap
  document.querySelectorAll('[data-strap]').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('[data-strap]').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      state.strapType = btn.dataset.strap;
      parts.bracelet.visible = state.strapType === 'steel';
      parts.leather.visible = state.strapType === 'leather';
      // Reset view mode when switching strap
      if (state.viewMode !== 'realistic') {
        applyViewMode('realistic');
        document.querySelectorAll('[data-view]').forEach(b => b.classList.remove('active'));
        document.querySelector('[data-view="realistic"]').classList.add('active');
        state.viewMode = 'realistic';
      }
    });
  });

  // Environment
  document.querySelectorAll('[data-env]').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('[data-env]').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      state.environment = btn.dataset.env;
      setEnvironment(state.environment);
    });
  });

  // Light intensity
  document.getElementById('light-intensity').addEventListener('input', e => {
    state.lightIntensity = e.target.value / 100;
    setEnvironment(state.environment);
  });

  // Rotation speed
  document.getElementById('rotation-speed').addEventListener('input', e => {
    state.rotationSpeed = e.target.value / 100;
    controls.autoRotateSpeed = state.rotationSpeed * 3;
  });

  // View mode
  document.querySelectorAll('[data-view]').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('[data-view]').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      state.viewMode = btn.dataset.view;
      applyViewMode(state.viewMode);
    });
  });

  // Focus views
  document.querySelectorAll('[data-focus]').forEach(btn => {
    btn.addEventListener('click', () => {
      const view = focusViews[btn.dataset.focus];
      if (view) flyTo(view.pos, view.target);
      if (btn.dataset.focus === 'reset') {
        setTimeout(() => { controls.autoRotate = true; }, 1600);
      }
    });
  });

  // Panel toggle (mobile)
  const panel = document.getElementById('control-panel');
  const toggle = document.getElementById('panel-toggle');
  let panelOpen = false;
  toggle.addEventListener('click', () => {
    panelOpen = !panelOpen;
    panel.style.transform = panelOpen ? 'translateX(0)' : 'translateX(100%)';
    toggle.querySelector('i').className = panelOpen ? 'fas fa-times text-sm' : 'fas fa-sliders-h text-sm';
  });

  // Idle detection for auto-rotate
  let idleTimeout;
  function resetIdle() {
    controls.autoRotate = false;
    clearTimeout(idleTimeout);
    idleTimeout = setTimeout(() => {
      if (!camTransition) controls.autoRotate = true;
    }, 4000);
  }
  renderer.domElement.addEventListener('pointerdown', resetIdle);
  renderer.domElement.addEventListener('wheel', resetIdle);
  renderer.domElement.addEventListener('touchstart', resetIdle, { passive: true });
}

/* =============================================
   ANIMATION LOOP
============================================= */
const clock = new THREE.Clock();

function animate() {
  requestAnimationFrame(animate);
  const t = clock.getElapsedTime();
  const dt = clock.getDelta();

  // Camera transition
  if (camTransition) {
    const elapsed = performance.now() - camTransition.start;
    const p = Math.min(elapsed / camTransition.duration, 1);
    const e = easeInOutCubic(p);
    camera.position.lerpVectors(camTransition.startPos, camTransition.endPos, e);
    controls.target.lerpVectors(camTransition.startTarget, camTransition.endTarget, e);
    if (p >= 1) camTransition = null;
  }

  controls.update();

  // Sweep light orbit
  const sweepAngle = t * 0.4;
  sweepLight.position.set(
    Math.cos(sweepAngle) * 5,
    2.5 + Math.sin(t * 0.3) * 0.5,
    Math.sin(sweepAngle) * 5
  );
  sweepLight.intensity = 1.0 + Math.sin(t * 0.8) * 0.5;

  // Subtle day-night cycle
  const dayCycle = (Math.sin(t * 0.08) + 1) / 2;
  const warmth = 0.85 + dayCycle * 0.15;
  mainLight.color.setRGB(warmth, warmth * 0.95, warmth * 0.85);

  // Second hand animation
  if (parts.secHand && state.viewMode === 'realistic') {
    parts.secHand.rotation.y = -t * 1.0;
  }

  // Dust particles drift
  const dPos = dust.geometry.attributes.position;
  for (let i = 0; i < dPos.count; i++) {
    let y = dPos.getY(i);
    y += Math.sin(t * 0.3 + i) * 0.001;
    dPos.setY(i, y);
    let x = dPos.getX(i);
    x += Math.cos(t * 0.2 + i * 0.5) * 0.0005;
    dPos.setX(i, x);
  }
  dPos.needsUpdate = true;

  // Subtle watch floating motion
  if (!camTransition) {
    watchGroup.position.y = Math.sin(t * 0.5) * 0.03;
  }

  renderer.render(scene, camera);
}

/* =============================================
   RESIZE
============================================= */
window.addEventListener('resize', () => {
  camera.aspect = window.innerWidth / window.innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(window.innerWidth, window.innerHeight);
});

/* =============================================
   INIT
============================================= */
async function init() {
  await Promise.race([
    document.fonts.ready,
    new Promise(r => setTimeout(r, 2500))
  ]);

  buildWatch();
  storeOriginalMaterials();
  setEnvironment('studio');
  setupUI();

  // Hide loading
  document.getElementById('loading-screen').classList.add('hidden');

  animate();
}

init();
</script>
