/* =============================================
   VIEW MODES
============================================= */
const origMats = {};

function storeOriginalMaterials() {
  watchGroup.traverse(child => {
    if (child.isMesh && child.material) {
      origMats[child.uuid] = {
        wireframe: child.material.wireframe,
        transparent: child.material.transparent,
        opacity: child.material.opacity,
        visible: child.visible,
        color: child.material.color ? child.material.color.getHex() : null,
      };
    }
  });
}

function applyViewMode(mode) {
  watchGroup.traverse(child => {
    if (!child.isMesh || !child.material) return;
    const orig = origMats[child.uuid];
    if (!orig) return;

    switch (mode) {
      case 'realistic':
        child.material.wireframe = false;
        child.material.transparent = orig.transparent;
        child.material.opacity = orig.opacity;
        child.material.needsUpdate = true;
        break;
      case 'wireframe':
        child.material.wireframe = true;
        child.material.transparent = false;
        child.material.opacity = 1;
        child.material.needsUpdate = true;
        break;
      case 'breakdown':
        child.material.wireframe = false;
        // Determine which part this mesh belongs to
        let parentGrp = child.parent;
        while (parentGrp && parentGrp !== watchGroup) parentGrp = parentGrp.parent;
        if (child === parts.crystal) {
          child.material.transparent = true;
          child.material.opacity = 0.5;
          child.material.color.set(0x4488ff);
        } else if (child === parts.dial) {
          child.material.transparent = false;
          child.material.opacity = 1;
        } else if (parts.hands && parts.hands.children.includes(child)) {
          child.material.transparent = true;
          child.material.opacity = 0.8;
        } else if (parts.case && (child === parts.case || parts.case.children.includes(child))) {
          child.material.transparent = true;
          child.material.opacity = 0.35;
        } else if (parts.bezel && (child === parts.bezel || parts.bezel.children.includes(child))) {
          child.material.transparent = true;
          child.material.opacity = 0.4;
          child.material.color.set(0x88aacc);
        } else if (parts.crown && parts.crown.children.includes(child)) {
          child.material.transparent = true;
          child.material.opacity = 0.6;
        } else if (parts.bracelet && parts.bracelet.children.includes(child)) {
          child.material.transparent = true;
          child.material.opacity = 0.3;
        } else if (parts.leather && parts.leather.children.includes(child)) {
          child.material.transparent = true;
          child.material.opacity = 0.3;
        } else {
          child.material.transparent = false;
          child.material.opacity = orig.opacity;
        }
        child.material.needsUpdate = true;
        break;
    }
  });
}

/* =============================================
   ENVIRONMENT SWITCHING
============================================= */
function setEnvironment(type) {
  const envMap = generateEnvMap(type);
  applyEnvMap(envMap);
  scene.environment = envMap;

  switch (type) {
    case 'studio':
      scene.background = new THREE.Color(0x0a0a0a);
      mainLight.intensity = 2.0 * state.lightIntensity;
      fillLight.intensity = 0.6;
      rimLight.intensity = 0.8;
      ambientLight.intensity = 0.5;
      renderer.toneMappingExposure = 1.3;
      break;
    case 'dark':
      scene.background = new THREE.Color(0x020202);
      mainLight.intensity = 0.6 * state.lightIntensity;
      fillLight.intensity = 0.15;
      rimLight.intensity = 0.3;
      ambientLight.intensity = 0.15;
      renderer.toneMappingExposure = 1.0;
      break;
    case 'outdoor':
      scene.background = new THREE.Color(0x1a2a3a);
      mainLight.intensity = 2.5 * state.lightIntensity;
      fillLight.intensity = 0.8;
      rimLight.intensity = 1.0;
      ambientLight.intensity = 0.7;
      renderer.toneMappingExposure = 1.4;
      break;
  }
}

